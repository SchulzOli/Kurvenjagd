{
  "name": "kurvenjaeger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kurvenreiche Motorradrouten aus OpenStreetMap – Android, iOS und Web",
  "license": "GPL-3.0-or-later",
  "author": "SchulzOli (https://github.com/SchulzOli)",
  "homepage": "https://github.com/SchulzOli/Kurvenjagd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SchulzOli/Kurvenjagd.git"
  },
  "bugs": {
    "url": "https://github.com/SchulzOli/Kurvenjagd/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --test",
    "icons": "python scripts/make-icons.py && npx @capacitor/assets generate --android --ios --iconBackgroundColor #0a0a0b --iconBackgroundColorDark #0a0a0b --splashBackgroundColor #0a0a0b --splashBackgroundColorDark #0a0a0b",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "apk": "node scripts/apk.mjs",
    "emu": "node scripts/emu.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@protomaps/basemaps": "^5.7.2",
    "cordova-plugin-purchase": "^13.20.0",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "pmtiles": "^4.5.0",
    "protomaps-leaflet": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "esbuild": "^0.28.2"
  }
}
